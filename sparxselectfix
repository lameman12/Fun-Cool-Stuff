(() => {
  "use strict";

  document.onselectstart = null;
  document.ondragstart = null;

  const STYLE_ID = "__sparx_select_paste_fix__";

  if (!document.getElementById(STYLE_ID)) {
    const style = document.createElement("style");
    style.id = STYLE_ID;
    style.textContent = `
      html, body, body * {
        -webkit-user-select: text !important;
        user-select: text !important;
        -webkit-touch-callout: default !important;
      }

      input,
      textarea,
      [contenteditable="true"],
      [contenteditable=""],
      [role="textbox"] {
        -webkit-user-select: text !important;
        user-select: text !important;
      }
    `;
    document.head.appendChild(style);
  }

  function isEditable(el) {
    if (!(el instanceof Element)) return false;

    if (
      el.matches(
        'textarea, input:not([type="button"]):not([type="submit"]):not([type="reset"]):not([type="checkbox"]):not([type="radio"]), [contenteditable="true"], [contenteditable=""], [role="textbox"]'
      )
    ) {
      return !el.hasAttribute("disabled") && !el.hasAttribute("readonly");
    }

    return !!el.closest(
      'textarea, input:not([type="button"]):not([type="submit"]):not([type="reset"]):not([type="checkbox"]):not([type="radio"]), [contenteditable="true"], [contenteditable=""], [role="textbox"]'
    );
  }

  function getEditable(el) {
    if (!(el instanceof Element)) return null;

    if (isEditable(el)) {
      return el.matches(
        'textarea, input, [contenteditable="true"], [contenteditable=""], [role="textbox"]'
      )
        ? el
        : el.closest(
            'textarea, input, [contenteditable="true"], [contenteditable=""], [role="textbox"]'
          );
    }

    return null;
  }

  function fireInput(el, text) {
    let event;

    try {
      event = new InputEvent("input", {
        bubbles: true,
        composed: true,
        inputType: "insertFromPaste",
        data: text
      });
    } catch {
      event = new Event("input", {
        bubbles: true,
        composed: true
      });
    }

    el.dispatchEvent(event);
    el.dispatchEvent(new Event("change", {
      bubbles: true,
      composed: true
    }));
  }

  function pasteIntoInput(el, text) {
    if (
      el instanceof HTMLInputElement ||
      el instanceof HTMLTextAreaElement
    ) {
      const type = (el.type || "text").toLowerCase();

      const rangeTypes = new Set([
        "text",
        "search",
        "tel",
        "url",
        "email",
        "password"
      ]);

      if (
        rangeTypes.has(type) &&
        typeof el.selectionStart === "number" &&
        typeof el.selectionEnd === "number"
      ) {
        el.setRangeText(
          text,
          el.selectionStart,
          el.selectionEnd,
          "end"
        );
        fireInput(el, text);
        return true;
      }

      const proto =
        el instanceof HTMLTextAreaElement
          ? HTMLTextAreaElement.prototype
          : HTMLInputElement.prototype;

      const setter = Object.getOwnPropertyDescriptor(
        proto,
        "value"
      )?.set;

      if (setter) {
        setter.call(el, text);
      } else {
        el.value = text;
      }

      fireInput(el, text);
      return true;
    }

    return false;
  }

  function pasteIntoContentEditable(el, text) {
    el.focus();

    try {
      if (document.execCommand("insertText", false, text)) {
        fireInput(el, text);
        return true;
      }
    } catch {}

    const selection = window.getSelection();

    if (!selection || selection.rangeCount === 0) {
      el.textContent += text;
      fireInput(el, text);
      return true;
    }

    const range = selection.getRangeAt(0);

    if (!el.contains(range.commonAncestorContainer)) {
      el.appendChild(document.createTextNode(text));
      fireInput(el, text);
      return true;
    }

    range.deleteContents();

    const node = document.createTextNode(text);
    range.insertNode(node);

    range.setStartAfter(node);
    range.collapse(true);

    selection.removeAllRanges();
    selection.addRange(range);

    fireInput(el, text);
    return true;
  }

  document.addEventListener(
    "selectstart",
    event => {
      event.stopImmediatePropagation();
    },
    true
  );

  document.addEventListener(
    "paste",
    event => {
      const el = getEditable(event.target);
      if (!el) return;

      const text = event.clipboardData?.getData("text/plain");
      if (typeof text !== "string") return;

      event.preventDefault();
      event.stopImmediatePropagation();

      if (
        el instanceof HTMLInputElement ||
        el instanceof HTMLTextAreaElement
      ) {
        pasteIntoInput(el, text);
      } else if (
        el.isContentEditable ||
        el.matches('[role="textbox"]')
      ) {
        pasteIntoContentEditable(el, text);
      }
    },
    true
  );

  const observer = new MutationObserver(() => {
    if (document.onselectstart) {
      document.onselectstart = null;
    }
  });

  observer.observe(document.documentElement, {
    subtree: true,
    childList: true,
    attributes: true
  });

  window.__sparxSelectPasteFix = {
    observer,
    remove() {
      observer.disconnect();
      document.getElementById(STYLE_ID)?.remove();
      delete window.__sparxSelectPasteFix;
    }
  };
})();
